{
  "name": "yahoo-mail-ai-connector",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:fake": "node dist/apps/local-connector/src/stdio.js --provider=fake",
    "mcp:yahoo": "node dist/apps/local-connector/src/stdio.js --provider=yahoo",
    "connector:setup": "pnpm run --silent build && node dist/apps/local-connector/src/cli.js setup",
    "connector:doctor": "pnpm run --silent build && node dist/apps/local-connector/src/cli.js doctor",
    "connector:remove": "pnpm run --silent build && node dist/apps/local-connector/src/cli.js remove",
    "probe:yahoo": "node dist/apps/local-connector/src/probes/yahoo-capabilities.js",
    "probe:keyring": "node dist/apps/local-connector/src/probes/keyring.js",
    "smoke:stdio": "node dist/tests/contract/stdio-smoke.js",
    "smoke:yahoo-metadata": "node dist/tests/contract/yahoo-live-smoke.js",
    "check": "pnpm run typecheck && pnpm test && pnpm run build && pnpm run smoke:stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@napi-rs/keyring": "2.1.0",
    "imapflow": "2.1.0",
    "mailparser": "3.9.29",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "3.4.6",
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
